# 复制成 .env 后按需修改。.env 不进 Git；密钥只写在 .env 或环境变量里。

# AI 面试用哪个 TTS 引擎：index2（默认）、index25、breeze2
AI_INTERVIEW_TTS_ENGINE=index2

# 大模型：DeepSeek。密钥在 https://platform.deepseek.com 申请，只写在 .env 或环境变量里
DEEPSEEK_API_KEY=
# 下面两项不填就用默认值。deepseek-flash 当前是 DeepSeek-V4.1-Flash-1017
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# RAAS 招聘平台（只读，用来导入岗位和候选人）。地址带不带末尾的 /api/v1 都可以
RAAS_BASE_URL=
RAAS_ADMIN_USERNAME=
RAAS_ADMIN_PASSWORD=

# 岗位和候选人：调大模型时的思考设置，取值 off、low、high、max
# 读简历、整理岗位描述（默认 off，照着原文整理不需要多想）
AI_INTERVIEW_TALENT_THINKING=off
# 生成候选人画像（默认 low）
AI_INTERVIEW_TALENT_PROFILE_THINKING=low
