# 复制成 .env 后按需修改。.env 不进 Git；密钥只写在 .env 或环境变量里。

# ── 平台 ──
# PostgreSQL 连接串，必填。本地开发用 scripts/dev-db.sh start 起一个库，它的地址是：
DATABASE_URL=postgres://ai_interview@127.0.0.1:54329/ai_interview
# 监听地址
AI_INTERVIEW_BIND=127.0.0.1:8080
# 对外地址，生成面试链接用。是 https 时会话 cookie 会带 Secure
AI_INTERVIEW_PUBLIC_URL=http://localhost:8080
# 文件（简历、音频、录像）存在这个目录下。不进 Git
AI_INTERVIEW_DATA_DIR=./data
# 前端构建产物的目录
AI_INTERVIEW_WEB_DIR=./web/dist
# 第一个管理员账号。库里没有这个邮箱时启动会创建；已经有了就不动它（不会改密码）
AI_INTERVIEW_ADMIN_EMAIL=
AI_INTERVIEW_ADMIN_PASSWORD=
# 同时跑几个后台任务
AI_INTERVIEW_TASK_WORKERS=4
# 日志级别，写法和 RUST_LOG 一样，比如 info、debug、interview_room=debug,info
AI_INTERVIEW_LOG=info

# ── 面试间 ──
# 面试链接默认多少小时后过期（生成链接时可以另外指定，最长 720）
AI_INTERVIEW_INVITE_TTL_HOURS=168
# 是否必须开摄像头。写 false 时，没有摄像头的设备可以只录声音
AI_INTERVIEW_ROOM_CAMERA_REQUIRED=true
# 面试进行中，页面多少分钟没有任何动静就算候选人离开了，面试按中途离开结束
AI_INTERVIEW_ROOM_ABANDON_MINUTES=15
# 浏览器录像多久切一个分片上传（毫秒，500 到 30000）。越短断网时丢得越少，请求越多
AI_INTERVIEW_ROOM_RECORDING_TIMESLICE_MS=5000
# 实时对话里，候选人停多少秒算说完一段（1 到 10）。面试配置里的静音时长比它短时用配置里的。
# 短了容易把想一想的停顿当成说完，长了面试官接话慢
AI_INTERVIEW_ROOM_REALTIME_SILENCE_SEC=2
# 语音识别用的是假后端时，面试中要不要也转写候选人的回答。假后端给的是固定的文字，不是候选人说的话，
# 所以默认不转；联调时想看整条链路通不通再打开
AI_INTERVIEW_ROOM_FAKE_TRANSCRIPT=false
# ffmpeg：从录像分片里取出候选人的声音做转写，合并录像后补上时长信息。不在 PATH 里时写完整路径。
# 没装时服务能启动，但面试中听不到候选人的回答，录像也拖不了进度条（系统状态里会显示）
# AI_INTERVIEW_FFMPEG=ffmpeg
# AI_INTERVIEW_FFPROBE=ffprobe

# ── 语音 ──
# AI 面试用哪个 TTS 引擎：index2（默认）、index25、breeze2
AI_INTERVIEW_TTS_ENGINE=index2
# 语音合成用哪个后端：fake（默认，不需要模型，输出测试音）或 worker（Mac 上常驻的 tts/worker/worker.py，真模型）
AI_INTERVIEW_TTS_BACKEND=fake
# worker 的地址，多个用逗号隔开（IndexTTS 和 Breeze 各一个进程），worker 后端必填
AI_INTERVIEW_TTS_WORKER_URLS=
# worker 那边设的令牌，两边要一致。worker 和后端不在同一台机器上时必填
AI_INTERVIEW_TTS_WORKER_TOKEN=

# 语音识别用哪个后端：fake（默认，不需要模型，返回固定文字）或 sherpa（真模型，编译时要加 --features sherpa）
AI_INTERVIEW_STT_BACKEND=fake
# sherpa 后端的模型目录，用 crates/interview-stt/scripts/download-models.sh 下载
AI_INTERVIEW_STT_MODEL_DIR=
# 识别一段话用几个线程，不填是 2
AI_INTERVIEW_STT_THREADS=

# ── 大模型 ──
# DeepSeek。密钥在 https://platform.deepseek.com 申请，只写在 .env 或环境变量里
DEEPSEEK_API_KEY=
# 下面两项不填就用默认值。deepseek-flash 当前是 DeepSeek-V4.1-Flash-1017
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# RAAS 招聘平台（只读，用来导入岗位和候选人）。地址带不带末尾的 /api/v1 都可以
RAAS_BASE_URL=
RAAS_ADMIN_USERNAME=
RAAS_ADMIN_PASSWORD=

# 岗位和候选人：调大模型时的思考设置，取值 off、low、high、max
# 读简历、整理岗位描述（默认 off，照着原文整理不需要多想）
AI_INTERVIEW_TALENT_THINKING=off
# 生成候选人画像（默认 low）
AI_INTERVIEW_TALENT_PROFILE_THINKING=low
