# 复制成 .env 后按需修改。.env 不进 Git；密钥只写在 .env 或环境变量里。

# AI 面试用哪个 TTS 引擎：index2（默认）、index25、breeze2
AI_INTERVIEW_TTS_ENGINE=index2

# 大模型：DeepSeek。密钥在 https://platform.deepseek.com 申请，只写在 .env 或环境变量里
DEEPSEEK_API_KEY=
# 下面两项不填就用默认值。deepseek-flash 当前是 DeepSeek-V4.1-Flash-1017
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
